{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Rolebeam",
  "version": "0.2.3",
  "description": "Unofficial Apple Careers resume matching, ranked applications, and submission review.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://jobs.apple.com/*",
    "https://www.apple.com/careers/*",
    "https://api.openai.com/*"
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.apple.com/*",
        "https://www.apple.com/careers/*"
      ],
      "js": [
        "lib/appleWithdrawalSafety.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jobs.apple.com/*",
        "https://www.apple.com/careers/*"
      ],
      "js": [
        "lib/appleApplicationSafety.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
